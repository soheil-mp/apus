# Copy to .env and fill in values for your machine. Never commit .env.
# Every variable the code reads must be listed here with a placeholder.
# Variables are introduced by the roadmap milestone named in brackets.

# --- Object storage (S3-compatible, local SeaweedFS by default) [M1] ---
APUS_S3_ENDPOINT=http://localhost:8333
APUS_S3_REGION=us-east-1
APUS_S3_BUCKET=apus-lake
APUS_S3_ACCESS_KEY_ID=your-access-key-id
APUS_S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- Lakehouse catalog (PostgreSQL for DuckLake metadata) [M1] ---
APUS_CATALOG_DSN=postgresql://apus:change-me@localhost:5432/apus_catalog

# --- Edge-to-platform messaging (NATS JetStream) [M1] ---
APUS_NATS_URL=nats://localhost:4222
APUS_NATS_CREDS_FILE=./secrets/nats/edge.creds

# --- Site and sensor selection [M2] ---
APUS_SITE_ID=demo-site
APUS_SENSOR_PROFILE=spinning-64

# --- External public data sources (no keys required) [M9] ---
APUS_ALOFT_BASE_URL=https://aloftdata.s3-eu-west-1.amazonaws.com
APUS_ALOFT_RADAR=nlhrw
APUS_OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1
APUS_AHN_BASE_URL=https://fsn1.your-objectstorage.com/hwh-ahn

# --- Observability (OpenTelemetry) [M16] ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=apus
